# Copie pra .env.local (não commitar) e preencha.
# Em produção, configurar via dashboard Vercel → Settings → Environment Variables.

# Neon Postgres connection string (Connection Details no console.neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret pra assinar JWT — gere com: openssl rand -hex 32
JWT_SECRET=

# Vercel Blob — gera em Vercel dashboard > Storage > Blob > Create Token
BLOB_READ_WRITE_TOKEN=

# Deploy hook do Vercel — Vercel dashboard > Settings > Git > Deploy Hooks
# Quando o admin salva, faz POST nessa URL pra disparar rebuild
VERCEL_DEPLOY_HOOK_URL=

# Origem permitida para CORS (em prod, o domínio do site)
ALLOWED_ORIGIN=https://irmaos-robaski-git-main-promoove.vercel.app
